---
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import type { Link as LinkType } from "@/types";

const links: LinkType[] = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "About me", href: "/about-me" },
	{ label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<nav
	class="backdrop-blur-xl bg-surface/90 dark:bg-surface/90 border border-primary/20 shadow-sm px-3 sm:px-4 py-2 h-12 flex items-center justify-between gap-2 sm:gap-4 transition-all duration-300">
	<div class="flex items-center gap-1 sm:gap-2">
		{
			links.map((link) => {
				const isActive =
					link.href === "/"
						? currentPath === "/"
						: currentPath.startsWith(link.href);
				return (
					<a
						href={link.href}
						class:list={[
							"text-xs sm:text-sm uppercase tracking-wider font-semibold px-2.5 sm:px-3 py-1.5 transition-all duration-200",
							isActive
								? "bg-primary text-on-primary"
								: "text-primary hover:bg-primary/10",
						]}>
						{link.label}
					</a>
				);
			})
		}
	</div>
	<div class="pl-1 sm:pl-2 border-l border-primary/20 flex items-center">
		<ThemeToggle />
	</div>
</nav>
