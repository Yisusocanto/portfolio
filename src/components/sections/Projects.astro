---
import ProjectCard from "@/components/ProjectCard.astro";
import Separator from "@/components/ui/Separator.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const priorityOrder = [
	"fialo",
	"venezuela-tasas-bot",
	"pixel-reviews",
	"venezuela-tasas",
	"smart-link",
];
const personalProjects = allProjects
	.filter((p) => p.data.category !== "work")
	.sort((a, b) => {
		const aIdx = priorityOrder.indexOf(a.id);
		const bIdx = priorityOrder.indexOf(b.id);
		return (aIdx !== -1 ? aIdx : 99) - (bIdx !== -1 ? bIdx : 99);
	});
const featuredProjects = personalProjects.slice(0, 4);
---

<section id="projects" class="py-10">
	<div class="mb-14">
		<div
			class="flex flex-col sm:flex-row justify-between items-baseline gap-4 mb-3">
			<div>
				<span
					class="text-xs uppercase tracking-[0.25em] text-primary/70 font-mono mb-2 block">
					02 / Software & Mobile Apps
				</span>
				<h3
					class="text-4xl sm:text-6xl md:text-7xl font-normal uppercase tracking-tighter leading-none font-neuehaasdisplay text-primary">
					SELECTED PROJECTS
				</h3>
			</div>
			<Button
				href="/projects"
				variant="ghost"
				class="text-xs p-0 tracking-widest font-semibold flex items-center gap-1.5 hover:text-primary transition-colors">
				View all projects ({personalProjects.length}) →
			</Button>
		</div>
		<Separator />
	</div>

	<div class="flex flex-col gap-20 md:gap-32">
		{
			featuredProjects.map((project, i) => (
				<ProjectCard
					title={project.data.title}
					description={project.data.description}
					imageUrl={project.data.imageUrl}
					techs={project.data.techs}
					type={project.data.type}
					slug={project.id}
					reverse={i % 2 != 0}
				/>
			))
		}
	</div>

	<div class="flex justify-center mt-16 sm:mt-24">
		<Button href="/projects" variant="primary" class="px-8 py-4">
			Explore All Works ({allProjects.length}) →
		</Button>
	</div>
</section>
