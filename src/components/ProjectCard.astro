---
import Chip from "@/components/ui/Chip.astro";
import Button from "@/components/ui/Button.astro";
import { Image } from "astro:assets";

interface Props {
	slug: string;
	title: string;
	description: string;
	techs: string[];
	imageUrl: any;
	type: string;
	reverse?: boolean;
}

const {
	description,
	imageUrl,
	techs,
	title,
	slug,
	type,
	reverse = false,
} = Astro.props;
---

<div
	class="grid grid-cols-1 md:grid-cols-12 gap-y-6 md:gap-y-0 items-center w-full relative group select-none">
	<a
		href={`/projects/${slug}`}
		class:list={[
			"aspect-16/10 sm:aspect-16/9 overflow-hidden border border-primary/20 bg-surface shadow-md z-0 transition-all duration-700 ease-out hover:border-primary/50 md:row-start-1 block relative",
			reverse ? "md:col-start-5 md:col-end-13" : "md:col-start-1 md:col-end-9",
		]}>
		<Image
			src={imageUrl}
			alt={`Mockup de ${title}`}
			class="w-full h-full object-cover filter brightness-95 group-hover:brightness-100 group-hover:scale-[1.03] transition-all duration-700 ease-out"
		/>
	</a>

	<div
		class:list={[
			"bg-surface p-6 sm:p-8 md:p-10 border border-primary/20 shadow-xl z-10 w-full flex flex-col justify-center md:row-start-1 transition-all duration-500 text-secondary",
			reverse
				? "md:col-start-1 md:col-end-7 md:text-start"
				: "md:col-start-7 md:col-end-13 text-start",
		]}>
		<div class="flex items-center gap-2 mb-3">
			<span
				class="text-[10px] tracking-[0.25em] font-semibold font-mono uppercase text-primary/70">
				{type}
			</span>
		</div>
		<h2
			class="text-3xl sm:text-4xl md:text-5xl font-normal font-neuehaasdisplay mb-4 uppercase tracking-tighter leading-none text-primary">
			<a href={`/projects/${slug}`} class="hover:opacity-70 transition-opacity">
				{title}
			</a>
		</h2>
		<p
			class="mb-6 text-sm sm:text-base font-sfuidisplay font-light leading-relaxed text-secondary/85">
			{description}
		</p>
		<div class="flex gap-2 flex-wrap mb-6">
			{
				techs.map((tech) => (
					<Chip icon={tech.replace(" ", "").toLowerCase()}>{tech}</Chip>
				))
			}
		</div>
		<div class="pt-2 border-t border-primary/10">
			<Button href={`/projects/${slug}`} variant="primary">
				Case Study & Breakdown →
			</Button>
		</div>
	</div>
</div>
