---
import Chip from "@/components/ui/Chip.astro";
import Button from "@/components/ui/Button.astro";
import { Image } from "astro:assets";

interface Props {
	title: string;
	number: number;
	techs: string[];
	github?: string;
	description: string;
	imageUrl: any;
	slug: string;
	live?: string;
	category?: "work" | "project" | string;
	isOpenSource?: boolean;
}

const {
	number,
	github,
	imageUrl,
	techs,
	title,
	description,
	slug,
	live,
	category = "project",
	isOpenSource = false,
} = Astro.props;

const badgeText =
	category === "work"
		? `${number.toString().padStart(2, "0")} — WORK EXPERIENCE`
		: isOpenSource
			? `${number.toString().padStart(2, "0")} — OPEN SOURCE`
			: `${number.toString().padStart(2, "0")} — PROJECT`;
---

<article class="group flex flex-col gap-6 select-none">
	<a
		href={`/projects/${slug}`}
		class="overflow-hidden border border-primary/20 bg-surface shadow-sm hover:border-primary/50 transition-all duration-500 block relative">
		<div class="w-full aspect-16/9 overflow-hidden bg-surface">
			<Image
				src={imageUrl}
				alt={`Mockup de ${title}`}
				class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
			/>
		</div>
	</a>

	<div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
		<div class="flex flex-col gap-3 flex-1 min-w-0 max-w-3xl">
			<div class="flex items-center gap-3">
				<span
					class="text-xs uppercase tracking-[0.2em] text-primary/70 font-mono font-semibold">
					{badgeText}
				</span>
			</div>

			<h3
				class="text-3xl sm:text-4xl text-primary font-normal uppercase tracking-tight font-neuehaasdisplay">
				<a href={`/projects/${slug}`} class="hover:opacity-75 transition-opacity">
					{title}
				</a>
			</h3>

			<p
				class="text-secondary/85 text-base sm:text-lg leading-relaxed font-light font-sfuidisplay">
				{description}
			</p>

			<div class="flex flex-wrap gap-2 pt-2">
				{
					techs.map((tech) => (
						<Chip icon={tech.replace(" ", "").toLowerCase()}>{tech}</Chip>
					))
				}
			</div>
		</div>

		<div
			class="flex flex-wrap lg:flex-col items-center lg:items-end justify-between lg:justify-start gap-3 shrink-0 pt-2">
			<div class="flex flex-wrap gap-3 items-center">
				{
					github && (
						<Button href={github} target="_blank" variant="outline">
							GitHub ↗
						</Button>
					)
				}
				{
					live && (
						<Button href={live} target="_blank" variant="outline">
							Live Demo ↗
						</Button>
					)
				}
				<Button href={`/projects/${slug}`} variant="primary">
					View Details →
				</Button>
			</div>
		</div>
	</div>
</article>
